@page
@model Sat.Web.Pages.AyudaModel
@{
    ViewData["Title"] = "Ayuda";
}

<section class="tarjeta">
    <h1>Ayuda</h1>
    <p>Seleccione una de las dos opciones disponibles:</p>

    <div class="opciones">
        <a class="opcion" asp-page="/Ayuda/Estudiante">
            <h2>1. Información del estudiante</h2>
            <p>Datos del autor del proyecto: nombre, carné, curso y repositorio en GitHub.</p>
        </a>

        <a class="opcion" asp-page="/Ayuda/Documentacion">
            <h2>2. Documentación del programa</h2>
            <p>Estructura de los mensajes de solicitud y respuesta, endpoints del servicio,
               reglas de negocio y guía de uso del simulador.</p>
        </a>
    </div>
</section>
