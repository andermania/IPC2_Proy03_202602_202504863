<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Simulador SAT</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="marca">Simulador SAT &mdash; DTE</div>
            <ul class="menu">
                <li><a asp-page="/Index">Enviar mensaje</a></li>
                <li class="desplegable">
                    <a asp-page="/Peticiones/Consultar" class="principal">Peticiones &#9662;</a>
                    <ul class="submenu">
                        <li><a asp-page="/Peticiones/Consultar">Consultar contribuyente</a></li>
                        <li><a asp-page="/Peticiones/ResumenIva">Resumen de IVA por fecha y NIT</a></li>
                        <li><a asp-page="/Peticiones/ResumenRango">Resumen por rango de fechas</a></li>
                        <li><a asp-page="/Peticiones/ReporteErrores">Reporte de facturas y errores</a></li>
                        <li><a asp-page="/Peticiones/Graficas">Gráficas</a></li>
                        <li><a asp-page="/Peticiones/ReportePdf">Reporte en PDF</a></li>
                    </ul>
                </li>
                <li class="desplegable">
                    <a asp-page="/Ayuda" class="principal">Ayuda &#9662;</a>
                    <ul class="submenu">
                        <li><a asp-page="/Ayuda/Estudiante">Información del estudiante</a></li>
                        <li><a asp-page="/Ayuda/Documentacion">Documentación del programa</a></li>
                    </ul>
                </li>
            </ul>
        </nav>
    </header>

    <main class="contenedor">
        @RenderBody()
    </main>

    <footer class="pie">
        <p>IPC2 &middot; Proyecto 3 &middot; Programa 1 (Frontend) &middot; Servicio 2 (API .NET Core)</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
