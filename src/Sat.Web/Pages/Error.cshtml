@page
@model Sat.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="tarjeta">
    <h1>Ha ocurrido un error</h1>
    <p>
        Ocurrió un error inesperado al procesar la solicitud. Verifique que el Servicio 2
        (API) esté ejecutándose en <code>http://localhost:5200</code> y vuelva a intentarlo.
    </p>

    @if (Model.ShowRequestId)
    {
        <p><strong>Identificador de la solicitud:</strong> <code>@Model.RequestId</code></p>
    }

    <p><a class="boton primario" asp-page="/Index">Volver al inicio</a></p>
</section>
